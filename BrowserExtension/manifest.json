{
  "manifest_version": 3,
  "name": "SmartApp Browser Context",
  "version": "0.4.0",
  "description": "仅将当前前台活动页面变化发送到本机 SmartApp；不读取后台标签、网页正文或输入。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "alarms", "storage"],
  "incognito": "not_allowed",
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "SmartApp：点击重新连接", "default_popup": "popup.html"}
}
